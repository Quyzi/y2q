[Unit]
Description=y2q away-grant sweep and refresh (one-shot)
Documentation=https://github.com/Quyzi/y2q
After=network.target

[Service]
# Runs `y2qd --key-sweep`: devices::unlock_home with an unattended provider, which
# sweeps expired grants and re-mints them. A home device with a second factor cannot be
# unlocked unattended: the sweep then logs and exits 0, and grants are refreshed at
# arm+boot unlocks and by `y2q admin device refresh`.
Type=oneshot
ExecStart=/usr/local/bin/y2qd --key-sweep --config /etc/y2q/config.toml

User=y2q-keyd
Group=y2q
SupplementaryGroups=tss
UMask=0077
ConfigurationDirectory=y2q
ConfigurationDirectoryMode=0750

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true

DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
# TPM-only deployments drop the next line (see y2q-keyd@.service).
DeviceAllow=char-hidraw rw
# IPAddressAllow= (if used) must include the Roughtime servers.

ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/y2q/keystore
PrivateTmp=true
ProtectProc=invisible
ProcSubset=pid

SystemCallFilter=@system-service
SystemCallFilter=memfd_secret
SystemCallFilter=~@privileged @resources @debug
SystemCallErrorNumber=EPERM
LimitMEMLOCK=infinity

LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RemoveIPC=true
