[Unit]
Description=y2qd post-quantum secure storage daemon
Documentation=https://github.com/Quyzi/y2q
After=network.target y2q-keyd.socket y2qd.socket
Wants=network.target
# Prefer socket activation so the REST port stays held across restarts
# (see deploy/y2qd.socket). Disable with `systemctl disable y2qd.socket`
# only when binding inside the process is intentional.
Requires=y2q-keyd.socket
# Keep the restart budget small so a persistently failing unlock does not loop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Unattended arm as root before EVERY start: stores empty one-time authorization that the
# helper consumes on the fetch. Hosts whose home device has a second factor (passcode or
# FIDO2 PIN) MUST remove this line (drop-in override: `ExecStartPre=` clears it) and an
# operator arms interactively first:
#   sudo y2q-keyarm --prompt-passcode --prompt-pin ; systemctl start y2qd
# Install `y2q-keyarm` as a separate file (mode 0700 root:root; not a hardlink of y2qd).
# The armed file is consumed by every fetch, so on such hosts a crash restart fails until
# an operator re-arms.
ExecStartPre=+/usr/local/bin/y2q-keyarm --config /etc/y2q/config.toml
ExecStart=/usr/local/bin/y2qd --config /etc/y2q/config.toml
Restart=on-failure
RestartSec=5s

User=y2qd
Group=y2q
# keystore_dir is group-shared (mode 1770, group y2q); y2qd owns users.redb/keystore.json,
# y2q-keyd owns devices.json and .devices.lock (0600). The .lock flock file is
# pre-created group-writable by deploy/y2q-keyd.tmpfiles.conf.

# Filesystem isolation
UMask=0077
StateDirectory=y2q
StateDirectoryMode=0750
ConfigurationDirectory=y2q
ConfigurationDirectoryMode=0750
# Config write ≡ security-admin. Keep /etc/y2q/config.toml root-owned (0640
# root:y2q) and do not grant limited-sudo operators edit rights. Mount it
# read-only into the unit so a compromised ops grant cannot flip
# allow_unprotected_memory / allow_insecure_bind / enforce_authorization
# (or retarget storage/keystore paths) and have the next restart honor them.
# Unlock for upgrades: `systemctl edit y2qd` with an empty
# `BindReadOnlyPaths=` override, edit the file, then remove the drop-in.
BindReadOnlyPaths=/etc/y2q/config.toml

# Capability restrictions
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true

# Namespace isolation. No TPM or hidraw: PrivateDevices hides them on purpose.
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/y2q
ProtectProc=invisible
ProcSubset=pid

# Syscall filtering. `memfd_secret` is not in `@system-service` (or any
# other systemd syscall group); without an explicit allow the filter
# returns EPERM and guarded-memory startup refuses to boot.
# ~@debug blocks ptrace and process_vm_readv against this daemon's siblings.
SystemCallFilter=@system-service
SystemCallFilter=memfd_secret
SystemCallFilter=~@privileged @resources @debug
SystemCallErrorNumber=EPERM

# Secretmem pages are charged to RLIMIT_MEMLOCK at mmap. A zero or tiny
# limit makes that mmap fail with EAGAIN.
LimitMEMLOCK=infinity

# Misc hardening
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
