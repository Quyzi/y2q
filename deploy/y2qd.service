[Unit]
Description=y2qd post-quantum secure storage daemon
Documentation=https://github.com/Quyzi/y2q
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/y2qd --config /etc/y2q/config.toml
Restart=on-failure
RestartSec=5s

User=y2qd
Group=y2qd

# Filesystem isolation
UMask=0027
StateDirectory=y2q
StateDirectoryMode=0750
ConfigurationDirectory=y2q
ConfigurationDirectoryMode=0750

# Capability restrictions
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true

# Namespace isolation
PrivateTmp=true
# Device unlock needs the TPM resource manager and the FIDO2 HID node. PrivateDevices=
# would hide both (it mounts a private /dev with pseudo-devices only), so it is replaced
# by a closed device policy plus an explicit allowlist.
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
# A TPM-only deployment that never registers an away device omits the next line.
# It admits every hidraw node to the cgroup device policy; the udev DAC rule
# deploy/70-y2q-fido2.rules (install as /etc/udev/rules.d/70-y2q-fido2.rules) is the
# real gate, because hotplugged nodes cannot be covered by BindPaths=.
DeviceAllow=char-hidraw rw
SupplementaryGroups=tss
# Roughtime is outbound UDP. ProtectSystem/IPAddressDeny are untouched here, but a unit that
# adds IPAddressAllow= must include the configured Roughtime servers or every away unlock
# on this host fails closed.
# Authenticator PIN for away-device unlock, when a device is registered with uv_required.
# Supply it as Y2QD_FIDO2_PIN from a source outside keystore_dir, or enter it at the prompt.
# Interactive entry is the default. A PIN file inside keystore_dir, or on the same medium as
# the registry, defeats the joint-theft protection, so none is shown here.
# User= and Group= must name a non-root account. SupplementaryGroups=tss is the only group grant.
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/y2q

# Syscall filtering. `memfd_secret` is not in `@system-service` (or any
# other systemd syscall group); without an explicit allow the filter
# returns EPERM and guarded-memory startup refuses to boot.
SystemCallFilter=@system-service
SystemCallFilter=memfd_secret
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Secretmem pages are charged to RLIMIT_MEMLOCK at mmap. A zero or tiny
# limit makes that mmap fail with EAGAIN.
LimitMEMLOCK=infinity

# Misc hardening
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
